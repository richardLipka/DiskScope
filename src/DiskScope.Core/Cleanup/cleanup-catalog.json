// DiskScope – catalog of known locations for disk cleanup.
//
// Edit a copy in the app's data folder (data\cleanup-catalog.json, via "Edit catalog" in the Cleanup panel):
// entries there replace built-in ones with the same "id", "disabled": true removes one, new ids are added.
//
// Fields:
//   id           unique name of the entry
//   category     temp | browser | dev | app | system | user  (for grouping and future filters)
//   safety       safe (cache, temporary) | caution (has a cost) | system (never delete by hand)
//   action       deleteContents (empty the folder) | delete (delete the item) | none (advice only)
//   paths        path patterns: %EnvironmentVariables%, {user} = every user profile folder, * ? wildcards
//   folderNames  folder names matched anywhere in the tree (nested matches are skipped)
//   minSize      report only matches at least this many bytes large
//   name, description, howTo   texts per language code ("cs", "en"; English is the fallback)
{
  "version": 1,
  "entries": [
    {
      "id": "user-temp",
      "category": "temp",
      "safety": "safe",
      "action": "deleteContents",
      "paths": [ "{user}\\AppData\\Local\\Temp" ],
      "name": { "cs": "Dočasné soubory uživatele", "en": "User temporary files" },
      "description": {
        "cs": "Dočasné soubory, které si aplikace a instalátory odkládají při práci. Většina zůstává zapomenutá po skončení programu.",
        "en": "Temporary files that applications and installers put aside while working. Most are left behind after the program ends."
      },
      "howTo": {
        "cs": "Smazat obsah složky. Soubory, které jsou právě používané, Windows přeskočí. Případně Nastavení > Systém > Úložiště > Dočasné soubory.",
        "en": "Delete the folder's contents. Files in use are skipped by Windows. Or Settings > System > Storage > Temporary files."
      }
    },
    {
      "id": "windows-temp",
      "category": "temp",
      "safety": "safe",
      "action": "deleteContents",
      "paths": [ "%SystemRoot%\\Temp" ],
      "name": { "cs": "Dočasné soubory Windows", "en": "Windows temporary files" },
      "description": {
        "cs": "Systémové dočasné soubory služeb a instalací.",
        "en": "System temporary files left by services and installations."
      },
      "howTo": {
        "cs": "Smazat obsah složky (vyžaduje práva správce), nebo Vyčištění disku > Dočasné soubory.",
        "en": "Delete the folder's contents (needs administrator rights), or Disk Cleanup > Temporary files."
      }
    },
    {
      "id": "crash-dumps",
      "category": "temp",
      "safety": "safe",
      "action": "deleteContents",
      "paths": [ "{user}\\AppData\\Local\\CrashDumps", "%SystemRoot%\\Minidump" ],
      "name": { "cs": "Výpisy pádů aplikací", "en": "Application crash dumps" },
      "description": {
        "cs": "Výpisy paměti vytvořené při pádu aplikace nebo systému. Potřebuje je jen vývojář, který pád ladí.",
        "en": "Memory dumps written when an application or the system crashed. Only needed by a developer debugging the crash."
      },
      "howTo": { "cs": "Smazat obsah složky.", "en": "Delete the folder's contents." }
    },
    {
      "id": "memory-dump",
      "category": "temp",
      "safety": "safe",
      "action": "delete",
      "paths": [ "%SystemRoot%\\MEMORY.DMP" ],
      "name": { "cs": "Úplný výpis paměti po modré obrazovce", "en": "Full memory dump after a blue screen" },
      "description": {
        "cs": "Výpis celé paměti z posledního pádu systému. Může mít desítky GB.",
        "en": "A dump of the whole memory from the last system crash. Can be tens of GB."
      },
      "howTo": {
        "cs": "Smazat, pokud pád nechcete analyzovat. Vytváření lze omezit: Systém > Upřesnit nastavení systému > Spuštění a zotavení.",
        "en": "Delete unless you want to analyse the crash. Can be limited in System > Advanced system settings > Startup and Recovery."
      }
    },
    {
      "id": "windows-error-reports",
      "category": "temp",
      "safety": "safe",
      "action": "deleteContents",
      "paths": [
        "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive",
        "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue",
        "{user}\\AppData\\Local\\Microsoft\\Windows\\WER"
      ],
      "name": { "cs": "Hlášení o chybách Windows", "en": "Windows Error Reporting files" },
      "description": {
        "cs": "Archiv a fronta hlášení o chybách aplikací pro Microsoft.",
        "en": "Archived and queued application error reports for Microsoft."
      },
      "howTo": {
        "cs": "Smazat obsah, nebo Vyčištění disku > Soubory hlášení chyb Windows.",
        "en": "Delete the contents, or Disk Cleanup > Windows error reports."
      }
    },
    {
      "id": "windows-update-download",
      "category": "system",
      "safety": "caution",
      "action": "none",
      "paths": [ "%SystemRoot%\\SoftwareDistribution\\Download" ],
      "name": { "cs": "Stažené aktualizace Windows", "en": "Downloaded Windows updates" },
      "description": {
        "cs": "Instalační balíčky Windows Update. Po instalaci aktualizací už nejsou potřeba, ale mazat je za běhu aktualizace se nemá.",
        "en": "Windows Update installation packages. Not needed once updates are installed, but should not be deleted while an update runs."
      },
      "howTo": {
        "cs": "Vyčištění disku > Vyčistit systémové soubory > Vyčištění služby Windows Update, nebo Nastavení > Úložiště > Dočasné soubory.",
        "en": "Disk Cleanup > Clean up system files > Windows Update Cleanup, or Settings > Storage > Temporary files."
      }
    },
    {
      "id": "delivery-optimization",
      "category": "system",
      "safety": "caution",
      "action": "none",
      "paths": [ "%SystemRoot%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache" ],
      "name": { "cs": "Mezipaměť optimalizace doručení", "en": "Delivery Optimization cache" },
      "description": {
        "cs": "Části aktualizací sdílené s dalšími počítači v síti.",
        "en": "Pieces of updates shared with other computers on the network."
      },
      "howTo": {
        "cs": "Vyčištění disku > Soubory optimalizace doručení. Sdílení lze vypnout v Nastavení > Windows Update > Rozšířené možnosti > Optimalizace doručení.",
        "en": "Disk Cleanup > Delivery Optimization Files. Sharing can be turned off in Settings > Windows Update > Advanced options > Delivery Optimization."
      }
    },
    {
      "id": "windows-old",
      "category": "system",
      "safety": "caution",
      "action": "none",
      "paths": [ "%SystemDrive%\\Windows.old" ],
      "name": { "cs": "Předchozí instalace Windows", "en": "Previous Windows installation" },
      "description": {
        "cs": "Zbytek systému před velkou aktualizací. Umožňuje návrat k předchozí verzi Windows (obvykle 10 dní).",
        "en": "The system as it was before a major upgrade. Allows going back to the previous Windows version (usually for 10 days)."
      },
      "howTo": {
        "cs": "Nastavení > Systém > Úložiště > Dočasné soubory > Předchozí instalace Windows. Ručně mazat nejde kvůli oprávněním.",
        "en": "Settings > System > Storage > Temporary files > Previous Windows installation(s). Deleting by hand fails on permissions."
      }
    },
    {
      "id": "recycle-bin",
      "category": "user",
      "safety": "safe",
      "action": "none",
      "paths": [ "%SystemDrive%\\$Recycle.Bin" ],
      "name": { "cs": "Koš", "en": "Recycle Bin" },
      "description": {
        "cs": "Smazané soubory čekající v koši. Místo se uvolní až po vysypání koše.",
        "en": "Deleted files waiting in the Recycle Bin. The space is freed only when it is emptied."
      },
      "howTo": {
        "cs": "Pravým tlačítkem na Koš na ploše > Vysypat koš. Nejdřív zkontrolujte, že tam není nic potřebného.",
        "en": "Right-click the Recycle Bin on the desktop > Empty Recycle Bin. Check first that nothing needed is in it."
      }
    },
    {
      "id": "thumbnail-cache",
      "category": "temp",
      "safety": "safe",
      "action": "none",
      "paths": [ "{user}\\AppData\\Local\\Microsoft\\Windows\\Explorer" ],
      "minSize": 104857600,
      "name": { "cs": "Mezipaměť miniatur Průzkumníka", "en": "Explorer thumbnail cache" },
      "description": {
        "cs": "Náhledy obrázků a videí. Průzkumník je má otevřené, proto je nelze smazat přímo.",
        "en": "Previews of pictures and videos. Explorer keeps them open, so they cannot be deleted directly."
      },
      "howTo": { "cs": "Vyčištění disku > Miniatury.", "en": "Disk Cleanup > Thumbnails." }
    },
    {
      "id": "chrome-cache",
      "category": "browser",
      "safety": "safe",
      "action": "deleteContents",
      "paths": [
