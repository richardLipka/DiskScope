        "{user}\\AppData\\Local\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage"
      ],
      "name": { "cs": "Mezipaměť Google Chrome", "en": "Google Chrome cache" },
      "description": {
        "cs": "Uložené části webových stránek pro rychlejší načítání. Hesla, záložky ani historie v nich nejsou.",
        "en": "Stored parts of web pages for faster loading. No passwords, bookmarks or history are in it."
      },
      "howTo": {
        "cs": "V Chrome: Nastavení > Ochrana soukromí > Vymazat údaje o prohlížení > Obrázky a soubory v mezipaměti. Nebo smazat obsah při zavřeném prohlížeči.",
        "en": "In Chrome: Settings > Privacy > Clear browsing data > Cached images and files. Or delete the contents with the browser closed."
      }
    },
    {
