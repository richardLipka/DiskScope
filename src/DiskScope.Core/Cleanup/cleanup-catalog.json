        "{user}\\AppData\\Local\\Microsoft\\Edge\\User Data\\*\\Service Worker\\CacheStorage"
      ],
      "name": { "cs": "Mezipaměť Microsoft Edge", "en": "Microsoft Edge cache" },
      "description": {
        "cs": "Uložené části webových stránek pro rychlejší načítání.",
        "en": "Stored parts of web pages for faster loading."
      },
      "howTo": {
